{
  "manifest_version": 3,
  "name": "Radar de Passagens - leitor",
  "version": "1.3",
  "description": "Lê os preços das páginas de companhias aéreas e programas de milhas que você abrir pelo Radar de Passagens e envia para a sua conta no Radar.",
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.up.railway.app/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "action": {
    "default_title": "Radar de Passagens"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.smiles.com.br/*",
        "https://*.latamairlines.com/*",
        "https://*.voeazul.com.br/*",
        "https://*.voegol.com.br/*"
      ],
      "js": [
        "pagina.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.smiles.com.br/*",
        "https://*.latamairlines.com/*",
        "https://*.voeazul.com.br/*",
        "https://*.voegol.com.br/*",
        "https://www.google.com/travel/flights*"
      ],
      "js": [
        "leitor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://*.up.railway.app/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.google.com/travel/flights*"
      ],
      "js": [
        "calendario.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
